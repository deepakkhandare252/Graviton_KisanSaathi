# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# FRONTEND API BASE URL (Leave /api for same-origin Express proxy or set http://localhost:8080/api for Spring Boot)
VITE_API_BASE_URL="/api"

# JWT AUTHENTICATION SECRET (Set a strong random secret in production)
JWT_SECRET="CHANGE_ME_TO_A_STRONG_64_CHAR_RANDOM_SECRET"

# SMS OTP PROVIDER CONFIGURATION (Indian SMS: msg91 | twilio | fast2sms)
# Real SMS OTPs require valid provider credentials. Leave blank in unconfigured environments.
SMS_PROVIDER="msg91"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="KSNSAT"

# Twilio alternative
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Fast2SMS alternative
FAST2SMS_API_KEY=""

# MYSQL DATABASE CONFIGURATION (Used by Java Spring Boot Backend in /backend)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="kisan_scheme_saathi"
DB_USER="root"
DB_PASSWORD=""
